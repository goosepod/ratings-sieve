# No credentials are copied from production.
AM_PREF_AUDIOMUSE_URL=http://127.0.0.1:5435
AM_PREF_SERVER=Navidrome
AM_PREF_NAVIDROME_URL=http://127.0.0.1:4533
AM_PREF_NAVIDROME_USER=
AM_PREF_NAVIDROME_PASSWORD=
# Alternative to user/password, if API key authentication is configured:
AM_PREF_NAVIDROME_API_KEY=
AM_PREF_TOKEN=
AM_PREF_UPSTREAM_TOKEN=
# Multi-user mode: uncomment and set an absolute path to a private profiles.json.
# Copy profiles.example.json, use actual Navidrome usernames, and set these secrets.
# AM_PREF_PROFILES_FILE=/absolute/path/to/profiles.json
SONIC_SIEVE_LISTENER_ONE_TOKEN=
SONIC_SIEVE_LISTENER_ONE_PASSWORD=
SONIC_SIEVE_LISTENER_TWO_TOKEN=
# In multi-user mode AM_PREF_TOKEN is an optional unfiltered bypass credential;
# it never selects a user's preferences. Legacy Navidrome credentials above are ignored.
